{
    "title": "凯旋门赏赛后：胜利",
    "text_block_list": [
        {
            "name": "金星复活节",
            "text": "“我竟然输了……？我输了……？”"
        },
        {
            "name": "金星复活节",
            "text": "“那……胜者是——”"
        },
        {
            "name": "实况",
            "text": "“第1名是<chrname>——！\n是<chrname>——！！”"
        },
        {
            "name": "秋川理事长",
            "text": "精彩……！\n五月，<chrname>做到了——"
        },
        {
            "name": "秋川理事长",
            "text": "五月……？"
        },
        {
            "name": "佐岳五月",
            "text": "……"
        },
        {
            "name": "秋川理事长",
            "text": "……"
        },
        {
            "name": "秋川理事长",
            "text": "太好了啊……五月。"
        },
        {
            "name": "观众",
            "text": "“恭喜！”\n“新的冠军诞生了！！”"
        },
        {
            "name": "",
            "text": "现场为<chrname>成就的伟业\n献上了响彻云霄的欢呼声。",
            "choice_data_list": [
                "恭喜你，<chrname>……！",
                "恭喜您<chrname>大人！"
            ]
        },
        {
            "name": "",
            "text": "她已经筋疲力尽了。\n我陪着她一同走向领奖台。"
        },
        {
            "name": "来自日本的记者",
            "text": "历史……改变了。"
        },
        {
            "name": "来自日本的记者",
            "text": "诶……？哈哈，糟了啊……\n我的手在抖，相机都拿不稳……"
        },
        {
            "name": "来自日本的记者",
            "text": "恭……恭喜你。\n<chrname>……谢谢你……！"
        },
        {
            "name": "日本的观众",
            "text": "快看。<chrname>她……\n日本的赛马娘正站在领奖台上——"
        },
        {
            "name": "日本的观众",
            "text": "她……即将举起那座奖杯……！"
        },
        {
            "name": "",
            "text": "仿佛在回应欢呼声般，\n<chrname>将奖杯高高举起。"
        },
        {
            "name": "",
            "text": "那一刻，我仿佛听到了遥远的大洋彼岸\n传来的喝彩声。"
        },
        {
            "name": "",
            "text": "“凯旋门赏”结束了。"
        },
        {
            "name": "",
            "text": "回到酒店的路上，我仰望着星空。\n胜利的余韵似乎还久久不能散去。"
        },
        {
            "name": "",
            "text": "<chrname>成为了王者……\n接下来要为她献上哪个头衔呢？",
            "choice_data_list": [
                "（如果她希望的话，就献上连霸的荣誉）"
            ]
        },
        {
            "name": "",
            "text": "传奇还远没结束。"
        },
        {
            "name": "",
            "text": "（沙……沙……）"
        },
        {
            "name": "二人",
            "text": "啊……！\n……"
        },
        {
            "name": "神鹰",
            "text": "天狼星前辈，偷偷溜出酒店\n这样好吗？"
        },
        {
            "name": "天狼星象征",
            "text": "这话我原封不动地还给你，神鹰。\n我可一直以为你是个乖孩子呢。"
        },
        {
            "name": "神鹰",
            "text": "哼哼，今天是破例啦！"
        },
        {
            "name": "神鹰",
            "text": "按捺不住这份激动的，\n可不止神鹰我一个哦。"
        },
        {
            "name": "天狼星象征",
            "text": "也就是说……"
        },
        {
            "name": "天狼星象征",
            "text": "哈……"
        },
        {
            "name": "天狼星象征",
            "text": "哎呀哎呀，居然都来了。"
        },
        {
            "name": "黄金船",
            "text": "我们也在哦——！\n天狼星♪"
        },
        {
            "name": "天狼星象征",
            "text": "中山……\n这家伙就交给你照顾了。"
        },
        {
            "name": "中山庆典",
            "text": "我先溜了——"
        },
        {
            "name": "天狼星象征",
            "text": "啊？！\n可恶，别跑啊！"
        },
        {
            "name": "里见光钻",
            "text": "哈啊……哈啊……哈啊……"
        },
        {
            "name": "曼城茶座",
            "text": "里见……别勉强——"
        },
        {
            "name": "",
            "text": "（吱吱——！）"
        },
        {
            "name": "曼城茶座",
            "text": "！"
        },
        {
            "name": "里见光钻",
            "text": "茶座前辈……？\n没事吧？你的脸色……"
        },
        {
            "name": "曼城茶座",
            "text": "不……我——"
        },
        {
            "name": "曼城茶座",
            "text": "没事……"
        }
    ]
}