{
    "title": "序章",
    "text_block_list": [
        {
            "name": "吾妻",
            "text": "……顺承天历吉时。\n诸位神驹，皆已蓄纳神力。"
        },
        {
            "name": "吾妻",
            "text": "今宵乃是『午式骏大祭』。"
        },
        {
            "name": "吾妻",
            "text": "――恭迎至诚至贵之祈愿吧。"
        },
        {
            "name": "大和赤骥",
            "text": "灵妙神焰，照彻前路。"
        },
        {
            "name": "防爆装束",
            "text": "千难万险，誓必逾越。"
        },
        {
            "name": "莫名其妙",
            "text": "平靖安泰，天下祥和。"
        },
        {
            "name": "雪之美人",
            "text": "可喜可贺。可喜可贺。\n呜呼，大吉大善！"
        },
        {
            "name": "摩耶重炮",
            "text": "――就在此时。"
        },
        {
            "name": "神驹们",
            "text": "四方之缘，汇聚于此。"
        },
        {
            "name": "神驹们",
            "text": "――我等神驹，谨奉驰骋。"
        },
        {
            "name": "吾妻",
            "text": "我等为何，与人相伴相生？"
        },
        {
            "name": "吾妻",
            "text": "……且让我们细细道来吧。"
        },
        {
            "name": "吾妻",
            "text": "关于我们“赛马娘”的往昔。"
        },
        {
            "name": "吾妻",
            "text": "溯流寻源，极目凝望，\n目之所及处，乃是一切的“开端”。"
        },
        {
            "text": "友朋，解读青史　―午式骏大祭―"
        }
    ]
}