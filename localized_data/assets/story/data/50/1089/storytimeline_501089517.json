{
    "title": "这样就没问题了……",
    "text_block_list": [
        {
            "name": "咖啡店大婶",
            "text": "来，胡萝卜意面好啦！"
        },
        {
            "name": "高尚骏逸",
            "text": "啊，谢、谢谢您……。"
        },
        {
            "name": "高尚骏逸",
            "text": "（……咦，奇怪……\n给我的不是叉子，是勺子……）"
        },
        {
            "name": "高尚骏逸",
            "text": "……那、那个……不好意思……。\n可以给我……叉子吗……。"
        },
        {
            "name": "咖啡店大婶",
            "text": "那边的胡萝卜汉堡好啦！下一位的香蕉牛排\n先放这里！苹果拉面的稍等一下哦——！"
        },
        {
            "name": "高尚骏逸",
            "text": "……那个…………叉子……。"
        },
        {
            "name": "高尚骏逸",
            "text": "………………。"
        },
        {
            "name": "高尚骏逸",
            "text": "（果然……用勺子还是不好吃啊……）"
        }
    ]
}