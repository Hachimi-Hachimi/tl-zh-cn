{
  "title": "因头痛而忧郁",
  "text_block_list": [
    {
      "name": "大鸣大放",
      "text": "记得，好像在这附近……。"
    },
    {
      "name": "大鸣大放",
      "text": "……唔……！　头疼……！"
    },
    {
      "name": "大鸣大放",
      "text": "呼……不疼了啊。"
    },
    {
      "name": "小卖部的姐姐",
      "text": "结账，一共1298日元～。"
    },
    {
      "name": "大鸣大放",
      "text": "电子支付――……唔！"
    },
    {
      "name": "大鸣大放",
      "text": "（又疼起来了……！　这次好久……唔）"
    },
    {
      "name": "小卖部的姐姐",
      "text": "那个……怎么了吗……？"
    },
    {
      "name": "大鸣大放",
      "text": "――――…………唔！！\n……没有…………什么……！"
    },
    {
      "name": "小卖部的姐姐",
      "text": "咿……！\n对，对不起！！"
    },
    {
      "name": "独白",
      "text": "大鸣大放\n似乎正在为严重的头疼苦恼……。"
    }
  ]
}
