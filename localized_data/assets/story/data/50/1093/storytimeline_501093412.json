{
    "title": "迎向英里CS",
    "text_block_list": [
        {
            "name": "",
            "text": "凯斯奇迹思考着目白善信那句\n『对心中涌起的感情，坦诚以待』\n究竟是什么意思。",
            "color_text_info_list": [
                "目白善信"
            ]
        },
        {
            "name": "",
            "text": "凯斯奇迹\n一边确认自己的心意，\n一边前往『英里CS』。"
        }
    ]
}
